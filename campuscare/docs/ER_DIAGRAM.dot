digraph ER {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=.48, ranksep=1.05, pad=.2, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#557c87", arrowsize=.6, penwidth=1.1, fontsize=9, fontname="DejaVu Sans"];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#88b4bd"><TR><TD COLSPAN="2" BGCOLOR="#184E5C"><FONT COLOR="white"><B>USERS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="9" COLOR="#385563">PK UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">unique</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">role</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">password_hash</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">bcrypt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_tags" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">skill_tags</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">text[]</FONT></TD></TR></TABLE>>];
locations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#88b4bd"><TR><TD COLSPAN="2" BGCOLOR="#184E5C"><FONT COLOR="white"><B>LOCATIONS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="9" COLOR="#385563">PK UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="building" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">building</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="floor" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">floor</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_no" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">room_no</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">text</FONT></TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#88b4bd"><TR><TD COLSPAN="2" BGCOLOR="#184E5C"><FONT COLOR="white"><B>CATEGORIES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="9" COLOR="#385563">PK UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">unique</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="default_sla_hours" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">default_sla_hours</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">CHECK &gt;0</FONT></TD></TR></TABLE>>];
tickets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#88b4bd"><TR><TD COLSPAN="2" BGCOLOR="#184E5C"><FONT COLOR="white"><B>TICKETS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="9" COLOR="#385563">PK UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="requester_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">requester_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK users</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">category_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK categories</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="location_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">location_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK locations</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sla_due_at" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">sla_due_at</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description_embedding" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">description_embedding</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">vector(384)</FONT></TD></TR></TABLE>>];
assignments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#88b4bd"><TR><TD COLSPAN="2" BGCOLOR="#184E5C"><FONT COLOR="white"><B>ASSIGNMENTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="9" COLOR="#385563">PK UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">ticket_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK tickets</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="technician_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">technician_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK users</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="assigned_by" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">assigned_by</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK users</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unassigned_at" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">unassigned_at</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">timestamp</FONT></TD></TR></TABLE>>];
status_history [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#88b4bd"><TR><TD COLSPAN="2" BGCOLOR="#184E5C"><FONT COLOR="white"><B>STATUS_HISTORY</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="9" COLOR="#385563">PK UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">ticket_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK tickets</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="changed_by" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">changed_by</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK users</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="old_status" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">old_status</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="new_status" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">new_status</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">enum</FONT></TD></TR></TABLE>>];
feedback [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#88b4bd"><TR><TD COLSPAN="2" BGCOLOR="#184E5C"><FONT COLOR="white"><B>FEEDBACK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="9" COLOR="#385563">PK UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">ticket_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK unique</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rating" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">rating</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">CHECK 1..5</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="comment" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">comment</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">text</FONT></TD></TR></TABLE>>];
duplicate_links [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#88b4bd"><TR><TD COLSPAN="2" BGCOLOR="#184E5C"><FONT COLOR="white"><B>DUPLICATE_LINKS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e7f1f2"><FONT POINT-SIZE="9" COLOR="#385563">PK UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">ticket_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK tickets</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="similar_ticket_id" BGCOLOR="#f4fafb"><FONT POINT-SIZE="10">similar_ticket_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f4fafb"><FONT POINT-SIZE="9" COLOR="#385563">FK tickets</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="similarity_score" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">similarity_score</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="9" COLOR="#385563">CHECK 0..1</FONT></TD></TR></TABLE>>];
users -> tickets:requester_id [label="1:N requester"];
categories -> tickets:category_id [label="1:N"];
locations -> tickets:location_id [label="1:N"];
tickets -> assignments:ticket_id [label="1:N"];
users -> assignments:technician_id [label="1:N technician"];
tickets -> status_history:ticket_id [label="1:N"];
users -> status_history:changed_by [label="1:N"];
tickets -> feedback:ticket_id [label="1:0..1"];
tickets -> duplicate_links:ticket_id [label="1:N"];
tickets -> duplicate_links:similar_ticket_id [label="1:N self-ref"];
}